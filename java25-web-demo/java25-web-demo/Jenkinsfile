pipeline {
    agent any

    tools {
        // Ensure 'JDK25' and 'Maven3' match the names configured in Manage Jenkins -> Tools
        jdk 'JDK25'
        maven 'Maven3'
    }

    environment {
        APP_PORT = '3000'
        DEPLOY_DIR = '/opt/java25-web-demo'
        JAR_NAME = 'app.jar'
    }

    stages {
        stage('Verify Environment') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy on Port 3000') {
            steps {
                sh """
                    mkdir -p ${DEPLOY_DIR}
                    cp target/${JAR_NAME} ${DEPLOY_DIR}/${JAR_NAME}

                    # Stop any existing process bound to port 3000
                    fuser -k ${APP_PORT}/tcp || true
                    sleep 2

                    # Start the application detached from Jenkins' process tree
                    JENKINS_NODE_COOKIE=dontKillMe nohup java -jar ${DEPLOY_DIR}/${JAR_NAME} --server.port=${APP_PORT} > ${DEPLOY_DIR}/app.log 2>&1 &
                """
            }
        }

        stage('Health Check') {
            steps {
                sh """
                    for i in 1 2 3 4 5 6; do
                        if curl -sf http://localhost:${APP_PORT}/health; then
                            echo "Application is up on port ${APP_PORT}"
                            exit 0
                        fi
                        sleep 3
                    done
                    cat ${DEPLOY_DIR}/app.log
                    exit 1
                """
            }
        }
    }
}
